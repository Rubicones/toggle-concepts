# Copy to .env.local only for a deliberately configured development project.
# npm run data:start generates ignored local-only values automatically.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Admin credential is used by the loopback-only demo seeder, never ordinary API reads.
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_DATABASE_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Dedicated Auth identity with worker membership, no campaign approval permission.
MEDIA_WORKER_EMAIL=
MEDIA_WORKER_PASSWORD=
# Explicit opt-in needed before a local validator can contact remote data/storage.
MEDIA_WORKER_ALLOW_REMOTE=false
MOCK_PROVIDERS=true

# Shared access is temporary and explicit; secrets remain server-only.
STUDIO_SHARED_MODE=true
STUDIO_LOCAL_COMPUTE=true
MEDIA_BACKEND=supabase
# One-time schema access: use one of these, never put it in a public variable.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=
