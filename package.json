{
  "name": "toggle-concepts",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.1 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "schema:check": "node --import tsx scripts/check-contracts.ts",
    "fixtures:generate": "node --import tsx scripts/generate-fixtures.ts",
    "render:sample": "node --import tsx apps/local-runner/render.ts",
    "render:verify": "node --import tsx apps/local-runner/verify.ts artifacts/m00/sample.mp4",
    "test:preview": "node --import tsx scripts/verify-preview.ts",
    "worker:dev": "node --import tsx apps/local-runner/worker.ts",
    "worker:check": "node --import tsx apps/local-runner/worker.ts --once",
    "test:studio": "node --import tsx scripts/verify-studio.ts",
    "data:start": "node --import tsx scripts/data-local.ts start",
    "data:stop": "node --import tsx scripts/data-local.ts stop",
    "data:status": "node --import tsx scripts/data-local.ts status",
    "data:migrate": "node --import tsx scripts/data-local.ts migrate",
    "seed:demo": "node --import tsx scripts/seed-demo.ts",
    "media:validate": "node --import tsx apps/local-runner/validate-uploads.ts --once",
    "media:worker": "node --import tsx apps/local-runner/validate-uploads.ts",
    "test:data": "node --import tsx scripts/verify-data.ts",
    "test:access": "node --import tsx scripts/verify-access-ui.ts",
    "test:auth": "node --import tsx scripts/verify-magic-link.ts",
    "dev:local": "node scripts/next-local.mjs dev --hostname 127.0.0.1 --port 3100",
    "build:local": "node scripts/next-local.mjs build",
    "start:local": "node scripts/next-local.mjs start --hostname 127.0.0.1 --port 3100",
    "dev:shared": "node scripts/next-shared.mjs dev --hostname 127.0.0.1 --port 3100",
    "build:shared": "node scripts/next-shared.mjs build",
    "start:shared": "node scripts/next-shared.mjs start --hostname 127.0.0.1 --port 3100",
    "data:deploy": "node --import tsx scripts/migrate-studio.ts",
    "test:creative": "node --import tsx --test tests/creative-drafts.test.ts",
    "render:creative": "node --import tsx scripts/verify-creative-render.ts",
    "test:creative-db": "python3 scripts/verify-creative-migration.py",
    "export:creative": "node --import tsx apps/local-runner/render-creative.ts",
    "verify:m09:static": "node --import tsx scripts/director/verify-static.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@fontsource/noto-sans": "5.3.0",
    "@napi-rs/canvas": "1.0.13",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@react-three/fiber": "9.8.2",
    "@remotion/layout-utils": "^4.0.538",
    "@remotion/lottie": "^4.0.538",
    "@remotion/media": "4.0.538",
    "@remotion/media-utils": "^4.0.538",
    "@remotion/noise": "^4.0.538",
    "@remotion/paths": "^4.0.538",
    "@remotion/player": "4.0.538",
    "@remotion/shapes": "^4.0.538",
    "@remotion/three": "4.0.538",
    "@remotion/transitions": "^4.0.538",
    "@remotion/web-renderer": "4.0.538",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.1",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "gsap": "^3.14.2",
    "harfbuzzjs": "1.6.3",
    "lucide-react": "1.61.0",
    "mammoth": "1.13.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.538",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "wawoff2": "2.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@remotion/bundler": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@tailwindcss/turbopack": "^4",
    "@types/fontkit": "2.0.9",
    "@types/node": "^20",
    "@types/pg": "8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pg": "8.23.1",
    "supabase": "2.122.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "zod": "$zod"
  }
}
